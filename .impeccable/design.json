  "narrative": {
    "northStar": "The Exchange Ledger",
    "overview": "LLM Providers is a calm operating interface: exact identities, separate supplier prices, and visible transaction states establish its character. Warm paper surrounds white comparison surfaces and a quieter request ledger. Compact type, structural hairlines, and restrained green controls keep consequential actions easy to locate.\n\nThe system treats real chain and local configuration state as the material of the interface. Empty states explain the missing state and offer a next action; status and recovery messages stay beside the relevant task. Product language remains concrete about testnet operation.",
    "keyCharacteristics": [
      "Warm neutral surfaces with a restrained forest-green action color.",
      "A compact sans interface paired with monospace machine identifiers.",
      "Structural separators, aligned numeric columns, and bounded task panels.",
      "Explicit pending, error, recovery, and confirmed states."
    ],
    "rules": [
      {
        "name": "The Operational Accent Rule",
        "body": "Green identifies an action, selection, or confirmed state. Keep neutral surfaces dominant.",
        "section": "colors"
      },
      {
        "name": "The Exact Identifier Rule",
        "body": "Use monospace for inspectable machine identifiers; align prices to the right with tabular numerals and explicit units.",
        "section": "typography"
      },
      {
        "name": "The Structural Depth Rule",
        "body": "Use tonal surfaces and hairline registration to separate tasks; keep panels flat at rest and on hover.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve separate input and output price columns, right-aligned tabular numerals, and explicit test MON units.",
      "Do make exact model identifiers and peer identities inspectable with the data type role.",
      "Do keep focus visible, fields explicitly labeled, and errors recoverable beside the affected task.",
      "Do use neutral surfaces, hairline separators, and green for action, selection, and confirmed state.",
      "Do preserve local table scrolling and stacked task flow on narrow screens."
    ],
    "donts": [
      "Don't present a pending transaction as complete before its confirmed receipt.",
      "Don't invent peers, prices, balances, activity, savings, or status to fill a surface.",
      "Don't replace the operating interface with a decorative hero or a generic chat landing page.",
      "Don't introduce nested cards or shadows where structural separators already express the task hierarchy."
    ]
  }
}
