# All public deployments and default clients use Monad TESTNET only.
CHAIN_ID=10143
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
VITE_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Fill after deploying both contracts through the app or deploy:monad.
REGISTRY_ADDRESS=
ESCROW_ADDRESS=
VITE_REGISTRY_ADDRESS=
VITE_ESCROW_ADDRESS=
# Optional CLI deployment signer: set locally; never commit or paste in chat.
DEPLOYER_PRIVATE_KEY=
# Provider wallet that owns the on-chain listing, and its authorized node operator.
PROVIDER_ADDRESS=
NODE_PRIVATE_KEY=
PROVIDER_PORT=8787
BIND_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STATE_DIR=.provider-state
# Model IDs are explicit operator configuration, not a hardcoded availability claim.
PROVIDER_MODELS_JSON=[]
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COMPATIBLE_API_KEY=
# Lit privacy setup only: consumer's execute-only usage key. Never put it in VITE_* or on a supplier relay.
# Private mode stays disabled until on-chain hardware/action/key binding and release review are available.
LIT_USAGE_API_KEY=
# One-time local credential commitment/sealing utility; never part of public action manifest.
UPSTREAM_API_KEY=
# Loopback API-key/personal OAuth helper. Public management wallet, never its private key.
# For saved supplier API keys this must equal PROVIDER_ADDRESS (not the node signing operator).
# This owner is pinned in the protected directory. Node/helper must share ACCOUNT_STATE_DIR.
# Optional for fresh local setup: npm run dev starts the helper, and first valid wallet
# initialization signature pins its owner. Existing owners cannot be changed this way.
ACCOUNT_OPERATOR_ADDRESS=
ACCOUNT_STATE_DIR=.account-state
ACCOUNT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174
